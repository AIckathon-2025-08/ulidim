# Frontend Environment Variables (for build time)
VITE_API_URL=https://your-backend-app.ondigitalocean.app/api
VITE_WS_URL=https://your-backend-app.ondigitalocean.app

# Backend Environment Variables
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-frontend-app.ondigitalocean.app
DB_HOST=your-db-host
DB_PORT=25060
DB_NAME=defaultdb
DB_USER=doadmin
DB_PASSWORD=your-db-password
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password_123